---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
const isExternal = project.href.startsWith('http');
const preview = project.featured ? project.screenshots?.[0] : undefined;
---

<article class:list={['project-card', `accent-${project.accent}`, { 'featured-product': project.featured }]}>
	<div class="project-card-top">
		{project.logo ? (
			<img class="project-logo" src={project.logo} alt="" width="46" height="46" />
		) : (
			<div class="project-mark" aria-hidden="true">{project.icon}</div>
		)}
		<span class="status"><span></span>{project.status}</span>
	</div>
	<p class="eyebrow">{project.eyebrow}</p>
	<h3>{project.name}</h3>
	<p class="project-description">{project.description}</p>
	{preview && (
		<div class="project-preview">
			<img src={preview.src} alt={preview.alt} width={preview.width} height={preview.height} loading="lazy" decoding="async" />
		</div>
	)}
	<ul class="tag-list" aria-label="Technologies">
		{project.tags.map((tag) => <li>{tag}</li>)}
	</ul>
	<a class="text-link" href={project.href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>
		{project.action}
		<span aria-hidden="true">{isExternal ? '↗' : '→'}</span>
	</a>
</article>
