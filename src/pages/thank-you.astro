---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You — Interlaced Pixel" description="Message received.">
	<section class="message-page">
		<div class="message-mark" aria-hidden="true">✓</div>
		<p class="kicker">Transmission received</p>
		<h1>Thanks for reaching out.</h1>
		<p>Your message is in. We’ll get back to you within two business days.</p>
		<a href="/" class="button primary">Return home →</a>
	</section>
</Layout>
