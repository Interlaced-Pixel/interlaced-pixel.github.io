---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [featuredPost, ...remainingPosts] = posts;
---

<Layout title="Journal — Interlaced Pixel" description="Practical notes on networking, systems programming, and building focused developer tools.">
	<header class="page-hero journal-hero">
		<div class="container narrow reveal">
			<p class="kicker"><span></span> Field notes</p>
			<h1>Ideas from the<br><em>workbench.</em></h1>
			<p>Technical walkthroughs, project updates, and practical lessons from building close to the network.</p>
		</div>
	</header>

	<div class="container journal-layout">
		{featuredPost && (
			<a href={`/blog/${featuredPost.slug}/`} class="featured-article reveal">
				<div class="featured-visual" aria-hidden="true">
					<div class="code-lines">
						<span></span><span></span><span></span><span></span><span></span>
					</div>
					<div class="feature-number">01</div>
				</div>
				<div class="featured-copy">
					<p class="article-meta">Featured · {featuredPost.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
					<h2>{featuredPost.data.title}</h2>
					<p>{featuredPost.data.description ?? 'A practical deep dive from the Interlaced Pixel workbench.'}</p>
					<span class="text-link">Read article <span aria-hidden="true">→</span></span>
				</div>
			</a>
		)}

		<section class="journal-index">
			<div class="section-heading reveal">
				<div>
					<p class="kicker">More writing</p>
					<h2>Latest entries</h2>
				</div>
				<span class="entry-count">{String(remainingPosts.length).padStart(2, '0')} articles</span>
			</div>
			<div class="article-list">
				{remainingPosts.map((post, index) => (
					<a class="article-row reveal" href={`/blog/${post.slug}/`}>
						<span class="article-index">{String(index + 2).padStart(2, '0')}</span>
						<div>
							<p>{Array.isArray(post.data.categories) ? post.data.categories[0] : post.data.categories ?? 'Engineering'} · {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
							<h3>{post.data.title}</h3>
						</div>
						<span class="article-arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</div>
		</section>
	</div>
</Layout>
