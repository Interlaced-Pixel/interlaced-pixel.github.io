---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

const post = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title} description={post.data.description}>
	<article class="post" itemscope itemtype="https://schema.org/BlogPosting">
		<header class="post-header reveal">
			<a href="/blog" class="back-link">← Back to journal</a>
			<p class="kicker">{Array.isArray(post.data.categories) ? post.data.categories[0] : post.data.categories ?? 'Engineering'}</p>
			<h1 itemprop="name headline">{post.data.title}</h1>
			<div class="post-meta">
				<time datetime={post.data.date.toISOString()} itemprop="datePublished">
					{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
				</time>
				<span>·</span>
				<span itemprop="author">{post.data.author ?? 'Interlaced Pixel'}</span>
			</div>
		</header>
		<div class="post-divider"></div>
		<div class="post-content" itemprop="articleBody">
			<Content />
		</div>
		<footer class="post-footer">
			<div>
				<p class="kicker">Keep exploring</p>
				<h2>More notes from the workbench.</h2>
			</div>
			<a href="/blog" class="button secondary">View all articles →</a>
		</footer>
	</article>
</Layout>
