---
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Layout from '../layouts/Layout.astro';
import { featuredProject, supportingProjects } from '../data/projects';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 2);
---

<Layout title="Interlaced Pixel — Lean tools. Clear results." description="Open-source networking tools and developer extensions built for performance, portability, and clarity.">
	<section class="home-hero">
		<div class="hero-grid" aria-hidden="true"></div>
		<div class="container hero-layout">
			<div class="hero-copy reveal">
				<p class="kicker"><span></span> Independent software studio</p>
				<h1>Small tools.<br><em>Serious utility.</em></h1>
				<p class="hero-lede">We design lean, dependable software for the systems that connect us—from network infrastructure to the editor you use every day.</p>
				<div class="button-row">
					<a href="/projects" class="button primary">Explore the work <span aria-hidden="true">→</span></a>
					<a href="https://github.com/Interlaced-Pixel" class="button secondary" target="_blank" rel="noopener">Follow on GitHub ↗</a>
				</div>
			</div>
			<div class="hero-terminal reveal" aria-label="Interlaced Pixel principles">
				<div class="terminal-bar">
					<span></span><span></span><span></span>
					<code>principles.txt</code>
				</div>
				<div class="terminal-body">
					<p><span>01</span> Performance without complexity</p>
					<p><span>02</span> Portable by default</p>
					<p><span>03</span> Useful on day one</p>
					<p><span>04</span> Open to inspection</p>
				</div>
				<div class="signal-orbit"><i></i><i></i><i></i></div>
			</div>
		</div>
		<div class="hero-strip" aria-label="Focus areas">
			<div class="container">
				<span>Network infrastructure</span>
				<span>C & C++</span>
				<span>Developer experience</span>
				<span>Open source</span>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading reveal">
				<div>
					<p class="kicker">Selected work</p>
					<h2>Tools with a clear job to do.</h2>
				</div>
				<a href="/projects" class="text-link">View all projects <span aria-hidden="true">→</span></a>
			</div>
			<FeaturedProject project={featuredProject} />
			<div class="project-grid supporting-grid">
				{supportingProjects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>

	<section class="section section-contrast">
		<div class="container approach-grid">
			<div class="approach-intro reveal">
				<p class="kicker light">How we build</p>
				<h2>Less machinery.<br>More momentum.</h2>
				<p>Every project starts with a real constraint and ends with something you can use, understand, and trust.</p>
			</div>
			<ol class="principles-list">
				<li class="reveal"><span>01</span><div><h3>Focused scope</h3><p>One product, one clear purpose. Features earn their place.</p></div></li>
				<li class="reveal"><span>02</span><div><h3>Systems-minded</h3><p>Performance, portability, and failure modes are designed in early.</p></div></li>
				<li class="reveal"><span>03</span><div><h3>Open work</h3><p>Readable source and useful documentation keep the work accessible.</p></div></li>
			</ol>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading reveal">
				<div>
					<p class="kicker">From the journal</p>
					<h2>Notes from the workbench.</h2>
				</div>
				<a href="/blog" class="text-link">Read the journal <span aria-hidden="true">→</span></a>
			</div>
			<div class="article-list">
				{latestPosts.map((post, index) => (
					<a class="article-row reveal" href={`/blog/${post.slug}/`}>
						<span class="article-index">0{index + 1}</span>
						<div>
							<p>{Array.isArray(post.data.categories) ? post.data.categories[0] : post.data.categories ?? 'Engineering'} · {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
							<h3>{post.data.title}</h3>
						</div>
						<span class="article-arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="cta-band">
		<div class="container reveal">
			<p class="kicker light">Have something in mind?</p>
			<h2>Let's make the useful thing.</h2>
			<a href="/contact" class="button light-button">Start a conversation <span aria-hidden="true">→</span></a>
		</div>
	</section>
</Layout>
