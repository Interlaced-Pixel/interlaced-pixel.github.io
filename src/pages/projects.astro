---
import ProjectCard from '../components/ProjectCard.astro';
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
---

<Layout title="Projects — Interlaced Pixel" description="Focused open-source tools for networking, systems work, and better developer workflows.">
	<header class="page-hero">
		<div class="container narrow reveal">
			<p class="kicker"><span></span> Open-source work</p>
			<h1>Built small.<br><em>Made to matter.</em></h1>
			<p>Each project solves a specific problem with as little friction as possible. No sprawling platforms—just dependable tools you can understand and put to work.</p>
		</div>
	</header>

	<section class="section projects-page">
		<div class="container">
			<div class="project-grid">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>

	<section class="project-note">
		<div class="container two-column reveal">
			<p class="kicker light">The standard</p>
			<div>
				<h2>Good tools disappear into the work.</h2>
				<p>We prioritize fast setup, predictable behavior, readable internals, and documentation that gets to the point.</p>
				<a href="https://github.com/Interlaced-Pixel" target="_blank" rel="noopener" class="text-link light-link">Browse every repository ↗</a>
			</div>
		</div>
	</section>
</Layout>
