---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Interlaced Pixel" description="Talk with Interlaced Pixel about a project, a contribution, or a technical question.">
	<header class="page-hero contact-page-hero">
		<div class="container narrow reveal">
			<p class="kicker"><span></span> Start a conversation</p>
			<h1>Let's build something<br><em>worth using.</em></h1>
			<p>Have a project, a contribution, or a good technical question? Send a note. We usually reply within two business days.</p>
		</div>
	</header>

	<section class="section contact-section">
		<div class="container contact-layout">
			<aside class="contact-aside reveal">
				<p class="kicker">Direct line</p>
				<a class="contact-email" href="mailto:support@interlacedpixel.com">support@interlacedpixel.com <span>↗</span></a>
				<div class="contact-details">
					<div><span>Based in</span><strong>Baton Rouge, Louisiana</strong></div>
					<div><span>Interested in</span><strong>Networking, systems, developer tools</strong></div>
					<div><span>Open source</span><a href="https://github.com/Interlaced-Pixel" target="_blank" rel="noopener">GitHub ↗</a></div>
				</div>
			</aside>

			<form id="contact-form" class="contact-form reveal" action="https://formspree.io/f/mpqjzbbj" method="POST">
				<input type="hidden" name="_subject" value="New message from interlacedpixel.com">
				<input type="hidden" name="_next" value="https://interlacedpixel.com/thank-you">
				<div class="form-row">
					<label>
						<span>Name</span>
						<input name="name" type="text" autocomplete="name" placeholder="Your name" required>
					</label>
					<label>
						<span>Email</span>
						<input name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
					</label>
				</div>
				<label>
					<span>What would you like to discuss?</span>
					<select name="subject" required>
						<option value="" disabled selected>Select a topic</option>
						<option>Project inquiry</option>
						<option>Open-source contribution</option>
						<option>Technical question</option>
						<option>Something else</option>
					</select>
				</label>
				<label>
					<span>Message</span>
					<textarea name="message" rows="7" placeholder="A little context goes a long way…" required></textarea>
				</label>
				<button type="submit" class="button primary">Send message <span aria-hidden="true">→</span></button>
			</form>
		</div>
	</section>
</Layout>
